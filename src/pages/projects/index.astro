---
import LabDoor from "../../components/LabDoor.astro"
import { labs, sections } from "../../data/personal"
import Layout from "../../layouts/Layout.astro"
import { getProjects } from "../../lib/content"

const [hardware, software] = await Promise.all([getProjects({ track: "hardware" }), getProjects({ track: "software" })])
---

<Layout title="Projects">
	<main class="min-h-screen bg-plane border-b-[20px] border-b-primary pt-40 pb-28">
		<div class="text-center max-w-4xl mx-auto px-6">
			<h1 class="font-bold text-5xl sm:text-6xl">{sections.doors.title}</h1>
			<p class="text-lg md:text-xl text-black-200 mt-8 leading-8">{sections.doors.intro}</p>
		</div>
		<div class="mt-16 max-w-7xl mx-auto px-6 sm:px-12 grid lg:grid-cols-2 gap-8">
			<LabDoor kind="hardware" {...sections.doors.hardware} projects={hardware} />
			<LabDoor kind="software" {...sections.doors.software} projects={software} />
		</div>
		<p class="text-center mt-10 text-black-200">
			<a href="/projects/archive" class="text-primary font-medium underline underline-offset-4">{labs.archive.title}</a>
		</p>
	</main>
</Layout>
