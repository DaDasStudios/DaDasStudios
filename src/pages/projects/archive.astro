---
import ProjectCard from "../../components/ProjectCard.astro"
import { labs } from "../../data/personal"
import Layout from "../../layouts/Layout.astro"
import { getProjects } from "../../lib/content"

const projects = await getProjects({ archive: true })
---

<Layout title={labs.archive.title} description={labs.archive.intro}>
	<main class="min-h-screen bg-print bg-fixed bg-cover border-b-[20px] border-b-primary pt-40 pb-28">
		<section class="max-w-7xl mx-auto px-6 sm:px-12">
			<h1 class="font-bold text-5xl sm:text-6xl">{labs.archive.title}</h1>
			<p class="text-xl text-black-200 mt-6 max-w-3xl leading-9">{labs.archive.intro}</p>
		</section>
		<section class="max-w-7xl mx-auto px-6 sm:px-12 mt-14 grid md:grid-cols-2 xl:grid-cols-3 gap-8">
			{projects.map(p => <ProjectCard project={p} />)}
		</section>
	</main>
</Layout>
