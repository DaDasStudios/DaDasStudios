---
import ButtonLink from "../components/ButtonLink.astro"
import ExperienceEntry from "../components/ExperienceEntry.astro"
import HighlightsCarousel from "../components/HighlightsCarousel.astro"
import LabDoor from "../components/LabDoor.astro"
import SkillRows from "../components/SkillRows.astro"
import StatCards from "../components/StatCards.astro"
import StoryTile from "../components/StoryTile.astro"
import { about, hero, sections } from "../data/personal"
import { resumes, site, socials } from "../data/site"
import Layout from "../layouts/Layout.astro"
import { getExperience, getHighlights, getProjects, getStories } from "../lib/content"

const [highlights, experience, hardware, software, stories] = await Promise.all([
	getHighlights(),
	getExperience(),
	getProjects({ track: "hardware" }),
	getProjects({ track: "software" }),
	getStories(),
])

const resumeFor = {
	all: resumes[0].href,
	hardware: resumes.find(r => r.track === "hardware")?.href ?? resumes[0].href,
	software: resumes.find(r => r.track === "software")?.href ?? resumes[0].href,
}
const taglineColor = { hardware: "text-secondary-800", software: "text-primary" }
---

<Layout title={site.name}>
	<main>
		<!-- HERO -->
		<section class="min-h-screen relative bg-blurry bg-cover pb-24" id="home-hero">
			<div class="flex flex-col pt-[190px] sm:pt-[230px] justify-center items-center gap-10 max-w-5xl mx-auto text-center px-6">
				<p class="uppercase tracking-[.25em] text-sm font-semibold text-black-200">{hero.eyebrow}</p>
				<h1 class="font-bold text-4xl sm:text-5xl md:text-7xl text-black-100 leading-tight">{hero.title}</h1>
				<p class="text-xl sm:text-3xl text-black-200 max-w-3xl leading-snug font-semibold">
					{
						hero.tagline.map(part =>
							"track" in part ? <span class={taglineColor[part.track]}>{part.text}</span> : part.text
						)
					}
				</p>
				<p class="text-lg text-black-200 max-w-2xl">{hero.description}</p>
				<div class="flex flex-wrap gap-6 justify-center items-center">
					{hero.actions.map(a => <ButtonLink href={a.href} style={a.style} size="lg">{a.label}</ButtonLink>)}
				</div>
				<div class="flex flex-col items-center gap-3 mt-2">
					<span class="text-sm text-black-200" id="focus-label">{hero.focusLabel}</span>
					<div class="inline-flex bg-white/80 rounded-full p-1 shadow-md" role="group" aria-labelledby="focus-label">
						<button data-focus="all" class="px-5 py-2 rounded-full text-sm font-semibold transition">Everything</button>
						<button data-focus="hardware" class="px-5 py-2 rounded-full text-sm font-semibold transition">Hardware</button>
						<button data-focus="software" class="px-5 py-2 rounded-full text-sm font-semibold transition">Software</button>
					</div>
				</div>
			</div>
			<span class="absolute inset-x-0 bg-primary h-5 z-10 -bottom-5"></span>
		</section>

		<HighlightsCarousel highlights={highlights} title={sections.highlights.title} intro={sections.highlights.intro} />
		<StatCards highlights={highlights} />

		<!-- ABOUT -->
		<section class="mx-6 md:mx-12 xl:mx-auto max-w-7xl pb-28 flex flex-col gap-12" id="about">
			<div class="max-w-4xl flex flex-col gap-5 leading-9 text-lg text-black-200">
				<h2 class="font-bold text-4xl sm:text-5xl text-black-100 mb-4">{about.title}</h2>
				{about.paragraphs.map(p => <p set:html={p} />)}
			</div>
			<SkillRows />
		</section>

		<!-- TWO DOORS -->
		<section id="doors" class="border-t-[20px] border-t-primary bg-plane py-28">
			<div class="text-center max-w-4xl mx-auto px-6">
				<h2 class="font-bold text-4xl sm:text-5xl text-black-100">{sections.doors.title}</h2>
				<p class="text-lg md:text-xl text-black-200 mt-8 leading-8">{sections.doors.intro}</p>
			</div>
			<div data-doors class="mt-16 max-w-7xl mx-auto px-6 sm:px-12 grid lg:grid-cols-2 gap-8">
				<LabDoor kind="hardware" {...sections.doors.hardware} projects={hardware} />
				<LabDoor kind="software" {...sections.doors.software} projects={software} />
			</div>
			<p class="text-center mt-10 text-black-200 [&_a]:text-primary [&_a]:font-medium [&_a]:underline [&_a]:underline-offset-4" set:html={sections.doors.archive} />
		</section>

		<!-- EXPERIENCE -->
		<section class="border-t-[20px] border-t-primary" id="experience">
			<div class="bg-black py-24 border-b-[20px] border-b-primary">
				<div class="text-center mx-6">
					<h2 class="text-4xl md:text-5xl font-bold text-white">{sections.experience.title}</h2>
					<p class="text-lg md:text-xl text-zinc-200 mt-10 max-w-4xl mx-auto leading-8" set:html={sections.experience.intro} />
				</div>
			</div>
			<div class="bg-plane py-24">
				<div class="max-w-7xl mx-auto px-6 sm:px-12">
					<div class="relative">
						<div class="absolute left-[10px] lg:left-[calc(14rem_-_2px)] top-0 bottom-0 w-1 bg-zinc-200 rounded-sm" aria-hidden="true"></div>
						{experience.map((entry, i) => <ExperienceEntry entry={entry} last={i === experience.length - 1} />)}
					</div>
				</div>
			</div>
		</section>

		<!-- BEYOND THE CODE -->
		<section class="border-y-[20px] border-y-primary py-28" id="beyond">
			<div class="text-center max-w-4xl mx-auto px-6">
				<h2 class="text-4xl md:text-5xl font-bold text-black-100">{sections.beyond.title}</h2>
				<p class="text-lg md:text-xl text-black-200 mt-8 leading-8">{sections.beyond.intro}</p>
			</div>
			<div class="mt-16 max-w-7xl mx-auto px-6 sm:px-12 grid grid-cols-1 md:grid-cols-4 auto-rows-[minmax(200px,auto)] gap-5">
				{stories.map(story => <StoryTile story={story} />)}
			</div>
		</section>

		<!-- CONTACT -->
		<section class="bg-blurry-2 bg-cover py-28" id="contact">
			<div class="max-w-4xl mx-auto px-6 text-center flex flex-col items-center gap-8">
				<h2 class="font-bold text-4xl sm:text-5xl">{sections.contact.title}</h2>
				<p class="text-lg sm:text-xl text-black-200 leading-8 max-w-2xl">{sections.contact.text}</p>
				<div class="flex flex-wrap gap-5 justify-center">
					<ButtonLink href={`mailto:${site.email}`} size="lg">Email me</ButtonLink>
					<ButtonLink
						href={resumeFor.all}
						style="outline"
						size="lg"
						target="_blank"
						data-focus-resume
						data-resume-all={resumeFor.all}
						data-resume-hardware={resumeFor.hardware}
						data-resume-software={resumeFor.software}>Download résumé</ButtonLink
					>
				</div>
				<ul class="flex gap-5 mt-2">
					{
						socials.map(s => (
							<li>
								<a
									href={s.link}
									target="_blank"
									rel="noopener"
									aria-label={s.name}
									class="w-12 h-12 bg-black-100 rounded-full shadow flex items-center justify-center transition hover:-translate-y-1 hover:bg-primary"
								>
									<img class="w-6 h-6" src={s.icon} alt="" />
								</a>
							</li>
						))
					}
				</ul>
				<p class="text-sm text-black-200 mt-6 max-w-xl">{sections.contact.visaNote}</p>
			</div>
		</section>
	</main>
</Layout>

<script>
	import "../scripts/focus"
</script>
